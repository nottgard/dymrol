# Copia este fichero a .env y ajusta los valores.
PORT=3001

# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://postgres:dev@localhost:5433/dym

# "production" → Express sirve también el front (client/dist) y las visitas se registran en cada carga de página.
# "development" → solo API (el front lo sirve Vite en :5173 con `pnpm dev`).
NODE_ENV=production

# Zona horaria que define "el día actual" para el salt de visitas (debe coincidir con la del cronjob)
VISITS_TIMEZONE=Europe/Madrid

# Si hay proxy/balanceador delante, nº de saltos de confianza para leer la IP real del visitante.
# Sin esto, todos los visitantes tendrían el mismo hash. Déjalo vacío si no hay proxy.
TRUST_PROXY=

# --- Acceso al back-office (/login) ---
ADMIN_USER=admin
# Genera el hash con: pnpm --filter server hash-password "tu contraseña"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de ≥32 caracteres para firmar las sesiones (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=
